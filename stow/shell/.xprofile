#!/bin/sh
# ~/.xprofile — graphical session environment.
# Read by SDDM through /usr/share/sddm/scripts/Xsession and by ~/.xinitrc.
# Set variables needed before the window manager starts here.

# bspwm is non-reparenting. This prevents gray windows that never redraw
# in Burp/Ghidra/ZAP/JADX.
export _JAVA_AWT_WM_NONREPARENTING=1
export AWT_TOOLKIT=XToolkit

# Fix Java scaling at 1 to avoid oversized Burp windows on 1440p monitors.
export _JAVA_OPTIONS='-Dsun.java2d.uiScale=1'

# Apply toolkit themes without loading a full desktop environment.
# theme.sh configures GTK/Qt/cursors through gtk-3.0/settings.ini and xsettingsd.
# Leave GTK_THEME unset because it would override both.
export XCURSOR_SIZE=24

# XDG — keep $HOME tidy and predictable.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

# Add custom scripts to PATH.
export PATH="$HOME/.local/bin:$PATH"

# >>> rice >>>
# Managed by install.sh; edit ~/.config/rice/env instead.
if [ -r "$HOME/.config/rice/env" ]; then
    . "$HOME/.config/rice/env"
fi
# <<< rice <<<
