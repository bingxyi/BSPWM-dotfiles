# offsec-dotfiles :: ambiente único da sessão
# Lido pelo ~/.xprofile (SDDM e startx), pelo bspwmrc e pelo ~/.zshrc.
# É o lugar certo para variáveis que precisam existir nos três caminhos.

export EDITOR="nvim"
export VISUAL="nvim"
# sudoedit consulta SUDO_EDITOR -> VISUAL -> EDITOR, e roda o editor COMO VOCÊ,
# com o ambiente intacto: seu ~/.config/nvim inteiro carrega ao editar /etc.
export SUDO_EDITOR="nvim"
export TERMINAL="kitty"
export BROWSER="firefox"
export PAGER="less"
export LESS="-R"

# bspwm é não-reparenting: sem isso Burp/ZAP/Ghidra/JADX abrem como janela cinza
export _JAVA_AWT_WM_NONREPARENTING=1
export AWT_TOOLKIT=XToolkit

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export ENGAGEMENT_DIR="${ENGAGEMENT_DIR:-$HOME/engagements}"
export OFFSEC_WALLPAPER_DIR="${OFFSEC_WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
export OFFSEC_VPN_DIR="${OFFSEC_VPN_DIR:-$HOME/vpn}"
export OFFSEC_PROXY_HOST="127.0.0.1"
export OFFSEC_PROXY_PORT="8080"

# Deixe vazio para detectar o monitor primário via xrandr.
# Preencha só se quiser forçar a barra em um monitor específico (ex.: DP-2).
export OFFSEC_BAR_MONITOR=""

export GTK_THEME_VARIANT=dark
export QT_QPA_PLATFORM=xcb
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export MOZ_X11_EGL=1

export GOPATH="${GOPATH:-$HOME/go}"
for offsec_bin in "$HOME/.config/offsec/bin" "$GOPATH/bin" "$HOME/.local/bin"; do
    case ":$PATH:" in
        *":$offsec_bin:"*) ;;
        *) PATH="$offsec_bin:$PATH" ;;
    esac
done
export PATH
unset offsec_bin

# US English for the desktop, shells and programs launched from this session.
export LANG=en_US.UTF-8
export LANGUAGE=en_US:en
unset LC_ALL LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY LC_MESSAGES
unset LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT LC_IDENTIFICATION
