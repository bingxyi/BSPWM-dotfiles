#!/bin/sh
# offsec-dotfiles :: SDDM Xsetup — roda como root antes do greeter aparecer.
#
# Instalar:  sudo install -Dm755 ~/.config/offsec/system/sddm-Xsetup /etc/sddm/Xsetup
# (o /etc/sddm.conf.d/10-offsec.conf já aponta DisplayCommand para esse caminho)
#
# Deixa só o monitor primário ativo no login: o vertical fica preto em vez de
# mostrar o greeter esticado. A sessão do usuário reexecuta o monitors.sh e
# devolve a geometria completa.

PRIMARY="HDMI-0"
MODE="1920x1080"
RATE="75"

# Se o primário configurado não estiver conectado, usa o primeiro conectado —
# nunca se sai daqui sem nenhuma saída ativa.
if ! xrandr --query | grep -q "^${PRIMARY} connected"; then
    PRIMARY=$(xrandr --query | awk '/ connected/ {print $1; exit}')
fi
[ -z "$PRIMARY" ] && exit 0

xrandr --output "$PRIMARY" --primary --mode "$MODE" --rate "$RATE" --pos 0x0 2>/dev/null \
    || xrandr --output "$PRIMARY" --primary --auto --pos 0x0 2>/dev/null

xrandr --query | awk '/ connected/ {print $1}' | while read -r out; do
    [ "$out" = "$PRIMARY" ] && continue
    xrandr --output "$out" --off 2>/dev/null
done

exit 0
