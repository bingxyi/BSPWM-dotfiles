/* Generated by theme.sh; do not edit by hand. */
* {
    bg:          {{bg}};
    bg-alt:      {{bg_alt}};
    bg-dim:      {{bg_dim}};
    surface:     {{surface}};
    overlay:     {{overlay}};
    muted:       {{muted}};
    fg:          {{fg}};
    fg-dim:      {{fg_dim}};
    accent:      {{accent}};
    accent-alt:  {{accent_alt}};
    urgent-col:  {{urgent}};
    green-col:   {{green}};
    yellow-col:  {{yellow}};
    blue-col:    {{blue}};

    /* rofi cannot use a variable for part of a compound property.
       Store the complete highlight value in a single variable.
       See rofi-theme(5) for compound property restrictions. */
    hl-accent:     bold {{accent}};
    hl-accent-alt: bold {{accent_alt}};
    hl-bg:         bold {{bg}};
}
