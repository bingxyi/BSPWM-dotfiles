/* rice :: wallpaper grid with previews */

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 10";
}

window {
    transparency:     "real";
    location:         center;
    width:            72%;
    height:           68%;
    border-radius:    18px;
    border:           2px;
    border-color:     @accent;
    background-color: @bg;
}

mainbox {
    padding:  22px;
    spacing:  16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt { text-color: @accent; vertical-align: 0.5; }
entry  { placeholder: "wallpaper…"; placeholder-color: @muted; vertical-align: 0.5; }

listview {
    columns:   4;
    lines:     3;
    spacing:   14px;
    scrollbar: false;
    cycle:     true;
    fixed-height: true;
}

element {
    orientation:   vertical;
    padding:       10px;
    spacing:       8px;
    border-radius: 12px;
    cursor:        pointer;
}

element-icon {
    size:         160px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    text-color:       @fg-dim;
}

element selected.normal {
    background-color: @surface;
    border:           2px;
    border-color:     @accent;
}

element selected.normal element-text { text-color: @fg; }

/* Import the palette last: rofi 2.0 resolves imported variables only
   when @import follows the declarations that use them. */
@import "../colors.rasi"
