/* BSPWM-dotfiles :: rofi */
configuration {
    modes: "drun,run,window,filebrowser";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: "  apps";
    display-run: "  exec";
    display-window: "  windows";
    display-filebrowser: "  files";
    window-format: "{w}  {c}   {t}";
    terminal: "kitty";
    sidebar-mode: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-cancel: "Escape,MouseSecondary";
    /* Control+k and Control+j default to kb-remove-to-eol and
       kb-accept-entry. rofi rejects an entire binding if any key is already
       assigned, which also disables the arrow keys in that binding.
       Clear the default assignment before reusing the key. */
    kb-remove-to-eol: "";
    kb-accept-entry: "Return,KP_Enter,Control+m";
    kb-row-up: "Up,Control+k,Control+p";
    kb-row-down: "Down,Control+j,Control+n";
    kb-mode-next: "Shift+Right,Control+Tab";
    kb-mode-previous: "Shift+Left,Control+Shift+Tab";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
}

@theme "~/.config/rofi/themes/offsec.rasi"
