#!/bin/sh
# rice :: SDDM Xsetup, run as root before showing the greeter
#
# Install: sudo install -Dm755 ~/.config/rice/system/sddm-Xsetup /etc/sddm/Xsetup
# /etc/sddm.conf.d/10-rice.conf points DisplayCommand to that path.
#
# Enable only the primary monitor at login, leaving the portrait screen
# black instead of stretching the greeter. The user session reruns
# monitors.sh to restore the full layout.

PRIMARY="HDMI-0"
MODE="1920x1080"
RATE="75"

# If the configured primary output is disconnected, use the first connected
# output. Always leave at least one output enabled.
if ! xrandr --query | grep -q "^${PRIMARY} connected"; then
    PRIMARY=$(xrandr --query | awk '/ connected/ {print $1; exit}')
fi
[ -z "$PRIMARY" ] && exit 0

xrandr --output "$PRIMARY" --primary --mode "$MODE" --rate "$RATE" --pos 0x0 2>/dev/null \
    || xrandr --output "$PRIMARY" --primary --auto --pos 0x0 2>/dev/null

xrandr --query | awk '/ connected/ {print $1}' | while read -r out; do
    [ "$out" = "$PRIMARY" ] && continue
    xrandr --output "$out" --off 2>/dev/null
done

exit 0
