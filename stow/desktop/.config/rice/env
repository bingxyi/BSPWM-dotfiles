# rice :: shared session environment
# Read by ~/.xprofile (SDDM and startx), bspwmrc, and ~/.zshrc.
# Define variables here when all three entry points need them.

export EDITOR="nvim"
export VISUAL="nvim"
# sudoedit checks SUDO_EDITOR -> VISUAL -> EDITOR and runs as your user,
# retaining the environment so your full Neovim configuration loads for /etc edits.
export SUDO_EDITOR="nvim"
export TERMINAL="kitty"
export BROWSER="firefox"
export PAGER="less"
export LESS="-R"

# bspwm is non-reparenting; this prevents gray windows in Burp/ZAP/Ghidra/JADX.
export _JAVA_AWT_WM_NONREPARENTING=1
export AWT_TOOLKIT=XToolkit

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export ENGAGEMENT_DIR="${ENGAGEMENT_DIR:-$HOME/engagements}"
export RICE_WALLPAPER_DIR="${RICE_WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
export RICE_VPN_DIR="${RICE_VPN_DIR:-$HOME/vpn}"
export RICE_PROXY_HOST="127.0.0.1"
export RICE_PROXY_PORT="8080"

# Leave empty to detect the primary monitor through xrandr.
# Set only to force the bar onto a specific output, such as DP-2.
export RICE_BAR_MONITOR=""

export GTK_THEME_VARIANT=dark
export QT_QPA_PLATFORM=xcb
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export MOZ_X11_EGL=1

export GOPATH="${GOPATH:-$HOME/go}"
for rice_bin in "$HOME/.config/rice/bin" "$GOPATH/bin" "$HOME/.local/bin"; do
    case ":$PATH:" in
        *":$rice_bin:"*) ;;
        *) PATH="$rice_bin:$PATH" ;;
    esac
done
export PATH
unset rice_bin

# US English for the desktop, shells and programs launched from this session.
export LANG=en_US.UTF-8
export LANGUAGE=en_US:en
unset LC_ALL LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY LC_MESSAGES
unset LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT LC_IDENTIFICATION
